# Site Configuration
NEXT_PUBLIC_SITE_URL=https://leelabiologics.com

# PostgreSQL (local development defaults; see compose.yaml)
DATABASE_URL=postgresql://leelabiologics_app:replace-with-a-local-password@localhost:5432/leelabiologics
DATABASE_SSL=false

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# reCAPTCHA for Forms (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# HubSpot Forms (Optional)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-portal-id
NEXT_PUBLIC_HUBSPOT_FORM_ID=your-form-id

# Email/SMTP (required for live contact form and careers application email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=replace-with-a-provider-app-password
SMTP_FROM=noreply@example.com
CONTACT_EMAIL=info@leelabiologics.com

# Admin dashboard (set unique, strong values in .env.local; do not commit them)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-password
ADMIN_SESSION_SECRET=replace-with-a-random-32-byte-secret

# Sanity CMS (Optional - when integrating CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token
