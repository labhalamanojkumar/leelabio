# Site Configuration
NEXT_PUBLIC_SITE_URL=https://leelabiologics.com

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# reCAPTCHA for Forms (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# HubSpot Forms (Optional)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-portal-id
NEXT_PUBLIC_HUBSPOT_FORM_ID=your-form-id

# Email/SMTP (Optional - for server-side form handling)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@leelabiologics.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@leelabiologics.com
CONTACT_EMAIL=info@leelabiologics.com

# Sanity CMS (Optional - when integrating CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token
